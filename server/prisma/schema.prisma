generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Startup {
  id          Int      @id @default(autoincrement())
  name        String
  idea        String
  foundedYear Int
  employees   Int
  fundingUsd  BigInt
  revenueUsd  BigInt
  outcome     String
  explanation String
}